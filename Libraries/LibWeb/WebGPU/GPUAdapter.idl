// https://gpuweb.github.io/gpuweb/#enumdef-gpupowerpreference
enum GPUPowerPreference {
    "low-power",
    "high-performance",
};

// https://gpuweb.github.io/gpuweb/#dictdef-gpurequestadapteroptions
dictionary GPURequestAdapterOptions {
    DOMString featureLevel = "core";
    GPUPowerPreference powerPreference;
    boolean forceFallbackAdapter = false;
    // FIXME: boolean xrCompatible = false;
};

// https://gpuweb.github.io/gpuweb/#gpuadapter
[Exposed=(Window, Worker), SecureContext]
interface GPUAdapter {
    // FIXME: [SameObject] readonly attribute GPUSupportedFeatures features;
    // FIXME: [SameObject] readonly attribute GPUSupportedLimits limits;
    // FIXME: [SameObject] readonly attribute GPUAdapterInfo info;

    // FIXME: Promise<GPUDevice> requestDevice(optional GPUDeviceDescriptor descriptor = {});
};
